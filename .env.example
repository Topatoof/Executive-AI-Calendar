# Database — SQLite for zero-setup local dev (default).
# For PostgreSQL: set provider in prisma/schema.prisma to postgresql and use e.g.:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/exec_ai?schema=public"
DATABASE_URL="file:./prisma/dev.db"

# OpenAI
OPENAI_API_KEY="sk-your-key-here"

# Optional: simple password gate for private hosted deploy
APP_PASSWORD=""

# App
NEXT_PUBLIC_APP_NAME="Exec AI"
